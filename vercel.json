{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/history", "destination": "/history.html" },
    { "source": "/login",   "destination": "/login.html" },
    { "source": "/profile", "destination": "/profile.html" }
  ]
}
